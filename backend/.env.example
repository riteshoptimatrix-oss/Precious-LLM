# ============================================
# Precious Edu LLM — Environment Variables
# ============================================
# Copy this file to .env and adjust values as needed.
# NEVER commit the .env file to version control.

# --- Server ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:8080

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=precious_edu_llm

# --- Model ---
MODEL_CHECKPOINT_PATH=../checkpoints/model/latest.pt
TOKENIZER_PATH=../checkpoints/tokenizer/

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30

# --- Logging ---
LOG_LEVEL=INFO

# --- Generation ---
MAX_MESSAGE_LENGTH=2000
MAX_RESPONSE_TOKENS=512
GENERATION_TEMPERATURE=0.7
GENERATION_TOP_K=50
GENERATION_TOP_P=0.9
